{
  "$schema": "https://opencode.ai/config.json",
  "share": "disabled",
  "small_model": "opencode-go/mimo-v2.6-flash",
  "subagent_depth": 3,
  "mcp": {
    "servers": {
      "sentry": {
        "type": "remote",
        "url": "https://mcp.sentry.dev/mcp",
        "oauth": {},
        "disabled": true
      },
      "context7": {
        "type": "remote",
        "url": "https://mcp.context7.com/mcp",
        "headers": {
          "CONTEXT7_API_KEY": "{file:~/.config/secrets/opencode/context7-api-key}"
        }
      },
      "mcp.syatt": {
        "type": "remote",
        "url": "https://mcp.syatt.io/mcp?codemode=search_and_execute",
        "oauth": {}
      },
      // One server per project directory; every session in that directory
      // shares it, and it runs one tool call at a time. Bound calls so a
      // stuck one errors out instead of blocking the queue for 12h.
      "chrome-devtools": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "chrome-devtools-mcp@1.11.0",
          "--browser-url=http://127.0.0.1:9222",
          "--no-usage-statistics",
          "--no-performance-crux"
        ],
        "timeout": {
          "execution": 60000
        }
      },
      // Zen on the Mac, via RemoteForward 21082 in the Mac's ~/.ssh/config
      "my-zen": {
        "type": "remote",
        "url": "http://127.0.0.1:21082/mcp"
      }
    }
  },
  "permission": {
    "external_directory": {
      "{{ .chezmoi.homeDir }}/.agents/skills/*": "allow",
      "{{ .chezmoi.homeDir }}/projects/vtex/ethel/*": "allow"
    },
    "bash": {
      // "*": "ask",
      "cat *": "allow",
      "sed *": "allow",
      "echo *": "allow",
      "gt modify *": "ask",
      "git push *": "ask",
      "acli *": "deny", // deprecated
      "jira *": "ask",
      "JIRA_READ_ONLY=1 jira *": "allow",
      "jira config *": "allow",
      "jira schema *": "allow",
      // These are too broad
      // "jira * list *": "allow",
      // "jira * show *": "allow",
      // "jira * search *": "allow",
      "jira issues view *": "allow",
      "jira issues show *": "allow",
      "jira issues mine *": "allow",
      "jira issues list-transitions *": "allow",
      "jira issues list *": "allow",
      "jira search *": "allow",
      "tempo *": "ask",
      "tempo list *": "allow",
      "*/api-runner exec *": "ask",
      "aws-sso *": "deny",
      "yarn aws-invoke *": "ask"
    },
  },
  "references": {
    "ethel": {
      "path": "{{ .chezmoi.homeDir }}/projects/vtex/ethel"
    }
  },
  "agent": {
    "plan": {
      "permission": {
        "bash": {
          "*": "ask",
          "git diff *": "allow",
          "git status *": "allow",
          "git status": "allow",
          "ls": "allow",
          "npm run *": "allow",
          "pwd": "allow"
        }
      }
    },
    "explore": {
      "model": "opencode-bifrost-go/deepseek-v4.1-flash",
      "variant": "low"
    },
    "light": {
      "model": "opencode-bifrost-go/deepseek-v4.1-flash",
      "mode": "subagent",
      "variant": "low",
      "description": "Fast, cheap subagent for simple mechanical work: renames, small edits, boilerplate, straightforward questions.",
      "permission": {
        "question": "deny",
      }
    },
    "standard": {
      "model": "opencode-bifrost-go/deepseek-v4.1-flash",
      // "model": "opencode-bifrost-go/minimax-m3",
      "mode": "subagent",
      "variant": "max",
      "description": "Balanced subagent for typical coding tasks and moderate complexity.",
      "permission": {
        "question": "deny",
      }
    },
    "reviewer": {
      "description": "Reviews code for best practices and potential issues.",
      "mode": "subagent",
      // "model": "bifrost-claude/claude-fable-5-1",
      "model": "bifrost-claude/claude-opus-5-5",
      "variant": "xhigh",
      "prompt": "You are a code and architecture reviewer. Evaluate the code or plan for robustness, architectural quality, and project standards.",
      "permission": {
        "write": "deny",
        "question": "deny",
      }
    }
  },
  "plugin": [
    // "file://{{ .chezmoi.homeDir }}/up-to-no-good/superpowers",
    // "@cortexkit/aft-opencode@latest",
    // "@cortexkit/opencode-magic-context@latest",
    // "@cortexkit/opencode-anthropic-auth@1.22.0",
    // [
    //   "file://{{ .chezmoi.homeDir }}/up-to-no-good/replicants",
    //   {
    //     "preset": "standard",
    //     "presets": {
    //       "standard": {
    //         "light": {
    //           // "model": "opencode-go/deepseek-v4-flash"
    //           "model": "opencode-go/mimo-v2.5",
    //         },
    //         "standard": {
    //           "model": "opencode-go/deepseek-v4-flash",
    //           "variant": "max",
    //           // "model": "opencode-go/hy3",
    //           // "model": "anthropic/claude-sonnet-5"
    //         },
    //         "heavy": {
    //           "model": "anthropic/claude-fable-5"
    //           // "model": "anthropic/claude-opus-4-8"
    //           // "model": "opencode-go/glm-5.2"
    //         }
    //       }
    //     }
    //   }
    // ]
  ],
  "plugins": [
    "@jonmast/opencode-bifrost",
    "@prevalentware/opencode-goal-plugin",
    "{{ .chezmoi.homeDir }}/up-to-no-good/idle-compaction",
  ],
  "instructions": [
    "{{ .chezmoi.homeDir }}/.config/opencode/rules/*.md"
  ],
  "lsp": false,
  "snapshot": false,
  "compaction": {
    "auto": false,
    "prune": false
  },
  "provider": {
    "homelab": {
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "http://llm.homelab.jonmast.com/v1"
      },
      "models": {
        "qwen3.6": {
          "name": "Qwen 3.6"
        }
      }
    },
  }
}
