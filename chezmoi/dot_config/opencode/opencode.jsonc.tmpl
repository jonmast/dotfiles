{
  "$schema": "https://opencode.ai/config.json",
  "share": "disabled",
  // "small_model": "opencode-go/deepseek-v4-flash",
  "small_model": "opencode-go/mimo-v2.5",
  "subagent_depth": 3,
  "mcp": {
    "mikes-minion": {
      "enabled": false,
      "headers": {
        "Authorization": "{file:~/.config/secrets/opencode/mikes-minion-authorization}"
      },
      "type": "remote",
      "url": "https://pm-dashboard-production-2c16.up.railway.app"
    },
    "sentry": {
      "enabled": false,
      "oauth": {},
      "type": "remote",
      "url": "https://mcp.sentry.dev/mcp"
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true,
      "headers": {
        "CONTEXT7_API_KEY": "{file:~/.config/secrets/opencode/context7-api-key}"
      }
    }
  },
  "permission": {
    "external_directory": {
      "/tmp/*": "allow",
    },
    "bash": {
      "gt modify *": "ask",
      "git push *": "ask",
      "acli *": "ask",
      "acli jira workitem search *": "allow",
      "acli jira workitem view *": "allow",
      "jira *": "ask",
      "JIRA_READ_ONLY=1 jira *": "allow",
      "jira schema": "allow",
      "jira * list *": "allow",
      "jira * show *": "allow",
      "jira issues view *": "allow",
      "jira issues show *": "allow",
      "jira issues mine *": "allow",
      "jira issues list-transitions *": "allow",
      "jira issues list *": "allow",
      "jira search *": "allow",
      "tempo *": "ask",
      "tempo list *": "allow",
      "*/api-runner exec *": "ask"
    },
  },
  "references": {
    "ethel": {
      "path": "{{ .chezmoi.homeDir }}/projects/vtex/ethel"
    }
  },
  "agent": {
    "plan": {
      "permission": {
        "bash": {
          "*": "ask",
          "git diff *": "allow",
          "git status *": "allow",
          "git status": "allow",
          "ls": "allow",
          "npm run *": "allow",
          "pwd": "allow"
        }
      }
    },
    "explore": {
      // "model": "opencode-go/deepseek-v4-flash",
      "model": "anthropic/claude-fable-5",
      "variant": "low"
    },
    "reviewer": {
      "description": "Reviews code for best practices and potential issues",
      "mode": "subagent",
      "model": "opencode-go/mimo-v2.5",
      "prompt": "You are a code and architecture reviewer. Evaluate the code or plan for robustness, architectural quality, and project standards",
      "permission": {
        "*": "deny",
        "read": "allow",
      }
    }
  },
  "plugin": [
    "file://{{ .chezmoi.homeDir }}/up-to-no-good/superpowers",
    "@cortexkit/aft-opencode@latest",
    // "@cortexkit/opencode-magic-context@0.36.0",
    "@cortexkit/opencode-anthropic-auth@1.18.0",
    [
      "file://{{ .chezmoi.homeDir }}/up-to-no-good/replicants",
      {
        "preset": "standard",
        "presets": {
          "standard": {
            "light": {
              // "model": "opencode-go/deepseek-v4-flash"
              "model": "opencode-go/mimo-v2.5",
            },
            "standard": {
              // "model": "opencode-go/deepseek-v4-flash",
              // "variant": "max",
              "model": "opencode-go/hy3",
              // "model": "anthropic/claude-sonnet-5"
            },
            "heavy": {
              "model": "anthropic/claude-fable-5"
              // "model": "anthropic/claude-opus-4-8"
              // "model": "opencode-go/glm-5.2"
            }
          }
        }
      }
    ]
  ],
  "instructions": [
    "{{ .chezmoi.homeDir }}/.config/opencode/rules/*.md"
  ],
  "lsp": false,
  "snapshot": false,
  "compaction": {
    "auto": false,
    "prune": false
  },
  "provider": {
    "homelab": {
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "http://llm.homelab.jonmast.com/v1"
      },
      "models": {
        "qwen3.6": {
          "name": "Qwen 3.6"
        }
      }
    },
  }
}
