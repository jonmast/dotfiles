{
  "$schema": "https://opencode.ai/config.json",
  "share": "disabled",
  "small_model": "opencode-go/mimo-v2.5",
  "subagent_depth": 3,
  "mcp": {
    "sentry": {
      "enabled": false,
      "oauth": {},
      "type": "remote",
      "url": "https://mcp.sentry.dev/mcp"
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true,
      "headers": {
        "CONTEXT7_API_KEY": "{file:~/.config/secrets/opencode/context7-api-key}"
      }
    },
    "mcp.syatt": {
      "type": "remote",
      "url": "https://mcp.syatt.io/mcp?codemode=search_and_execute",
      "oauth": {}
    }
  },
  "permission": {
    "bash": {
      "gt modify *": "ask",
      "git push *": "ask",
      "acli *": "ask",
      "acli jira workitem search *": "allow",
      "acli jira workitem view *": "allow",
      "jira *": "ask",
      "JIRA_READ_ONLY=1 jira *": "allow",
      "jira schema *": "allow",
      // These are too broad
      // "jira * list *": "allow",
      // "jira * show *": "allow",
      // "jira * search *": "allow",
      "jira issues view *": "allow",
      "jira issues show *": "allow",
      "jira issues mine *": "allow",
      "jira issues list-transitions *": "allow",
      "jira issues list *": "allow",
      "jira search *": "allow",
      "tempo *": "ask",
      "tempo list *": "allow",
      "*/api-runner exec *": "ask",
      "aws-sso *": "deny",
      "yarn aws-invoke *": "ask"
    },
  },
  "references": {
    "ethel": {
      "path": "{{ .chezmoi.homeDir }}/projects/vtex/ethel"
    }
  },
  "agent": {
    "plan": {
      "permission": {
        "bash": {
          "*": "ask",
          "git diff *": "allow",
          "git status *": "allow",
          "git status": "allow",
          "ls": "allow",
          "npm run *": "allow",
          "pwd": "allow"
        }
      }
    },
    "explore": {
      "model": "cliproxyapi-opencode-go/deepseek-v4-flash",
      "variant": "low"
    },
    "light": {
      "model": "cliproxyapi-opencode-go/deepseek-v4-flash",
      "mode": "subagent",
      "variant": "low",
      "description": "Fast, cheap subagent for simple mechanical work: renames, small edits, boilerplate, straightforward questions.",
    },
    "standard": {
      "model": "cliproxyapi-opencode-go/deepseek-v4-flash",
      "mode": "subagent",
      "variant": "max",
      "description": "Balanced subagent for typical coding tasks and moderate complexity.",
    },
    "reviewer": {
      "description": "Reviews code for best practices and potential issues. Subagent has no tools, so pass diff/etc in prompt",
      "mode": "subagent",
      "model": "cliproxyapi-anthropic/claude-fable-5-1",
      "prompt": "You are a code and architecture reviewer. Evaluate the code or plan for robustness, architectural quality, and project standards. You don't have access to many tools, if there is data you need stop and respond with a request for the missing data",
      "permission": {
        "*": "deny",
        "read": "allow",
        "bash": {
          "git *": "allow"
        }
      }
    }
  },
  "plugin": [
    // "file://{{ .chezmoi.homeDir }}/up-to-no-good/superpowers",
    // "@cortexkit/aft-opencode@latest",
    // "@cortexkit/opencode-magic-context@latest",
    // "@cortexkit/opencode-anthropic-auth@1.22.0",
    // [
    //   "file://{{ .chezmoi.homeDir }}/up-to-no-good/replicants",
    //   {
    //     "preset": "standard",
    //     "presets": {
    //       "standard": {
    //         "light": {
    //           // "model": "opencode-go/deepseek-v4-flash"
    //           "model": "opencode-go/mimo-v2.5",
    //         },
    //         "standard": {
    //           "model": "opencode-go/deepseek-v4-flash",
    //           "variant": "max",
    //           // "model": "opencode-go/hy3",
    //           // "model": "anthropic/claude-sonnet-5"
    //         },
    //         "heavy": {
    //           "model": "anthropic/claude-fable-5"
    //           // "model": "anthropic/claude-opus-4-8"
    //           // "model": "opencode-go/glm-5.2"
    //         }
    //       }
    //     }
    //   }
    // ]
  ],
  "plugins": [
    "@jonmast/opencode-cliproxyapi",
  ],
  "instructions": [
    "{{ .chezmoi.homeDir }}/.config/opencode/rules/*.md"
  ],
  "lsp": false,
  "snapshot": false,
  "compaction": {
    "auto": false,
    "prune": false
  },
  "provider": {
    "homelab": {
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "http://llm.homelab.jonmast.com/v1"
      },
      "models": {
        "qwen3.6": {
          "name": "Qwen 3.6"
        }
      }
    },
  }
}
