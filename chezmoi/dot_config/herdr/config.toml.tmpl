onboarding = false
[keys]
prefix = "ctrl+a"

focus_pane_left = "ctrl+h"
focus_pane_down = "ctrl+j"
focus_pane_up = "ctrl+k"
focus_pane_right = "ctrl+l"

navigate_pane_left = "h"
navigate_pane_down = "j"
navigate_pane_up = "k"
navigate_pane_right = "l"

split_vertical = 'prefix+\'
split_horizontal = "prefix+-"

new_tab = "prefix+c"
reload_config = "prefix+shift+r"
resize_mode = "prefix+r"

copy_mode = "prefix+["

previous_workspace = "prefix+up"
next_workspace = "prefix+down"

[[keys.command]]
key = "prefix+a"
type = "popup"
command = 'tmux -L herdr -f $HOME/.config/herdr/pi-tmux.conf new-session -A -D -s pi-assist -c "$HOME" "PATH=$HOME/.local/share/mise/installs/node/lts-jod/bin:$PATH pi --session-id herdr-assist --append-system-prompt $HOME/.config/herdr/pi-assist-prompt.md"'
description = "pi assist popup"
width = "80%"
height = "80%"

[[keys.command]]
key = "prefix+o"
type = "plugin_action"
command = "herdr-zoxide.browse"
description = "Browse zoxide directories"

[[keys.command]]
key = "cmd+r"
type = "popup"
command = "~/.config/herdr/scripts/herdr-review-branch.sh"
description = "Review a recent branch (stack-aware)"
width = "70%"
height = "60%"

[terminal]
{{- if eq .chezmoi.os "darwin" }}
default_shell = "/bin/zsh"
{{- else }}
default_shell = "{{ lookPath "zsh" }}"
{{- end }}

[ui]
mouse_capture = true
pane_gaps = false
show_agent_labels_on_pane_borders = true
prompt_new_tab_name = false
confirm_close = true

agent_panel_sort = "spaces"
[ui.sound]
enabled = false

[advanced]
scrollback_limit_bytes = 2000000

[theme]
name = "tokyo-night"
auto_switch = false

[[keys.command]]
key = "prefix+j"
type = "plugin_action"
command = "han.jira-worktree.open-jira"
description = "Jira: open (split)"

[[keys.command]]
key = "prefix+shift+j"
type = "plugin_action"
command = "han.jira-worktree.open-jira-tab"
description = "Jira: open (tab)"
