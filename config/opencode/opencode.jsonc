{
  "$schema": "https://opencode.ai/config.json",
  "share": "disabled",
  "small_model": "opencode-go/deepseek-v4-flash",
  "mcp": {
    "mikes-minion": {
      "enabled": false,
      "headers": {
        "Authorization": "{file:~/.config/secrets/opencode/mikes-minion-authorization}"
      },
      "type": "remote",
      "url": "https://pm-dashboard-production-2c16.up.railway.app"
    },
    "sentry": {
      "enabled": false,
      "oauth": {},
      "type": "remote",
      "url": "https://mcp.sentry.dev/mcp"
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true,
      "headers": {
        "CONTEXT7_API_KEY": "{file:~/.config/secrets/opencode/context7-api-key}"
      }
    }
  },
  "permission": {
    "bash": {
      "gt modify *": "ask",
      "git push *": "ask",
      "acli *": "ask",
      "acli jira workitem search *": "allow",
      "acli jira workitem view *": "allow",
      "jira *": "ask",
      "JIRA_READ_ONLY=1 jira *": "allow",
      "jira schema": "allow",
      "jira * list *": "allow",
      "jira * show *": "allow",
      "jira issues view *": "allow",
      "jira issues show *": "allow",
      "jira issues mine *": "allow",
      "jira issues list-transitions *": "allow",
      "jira issues list *": "allow",
      "jira search *": "allow",
      "tempo *": "ask",
      "tempo list *": "allow",
      "*/api-runner exec *": "ask"
    },
  },
  "references": {
    "ethel": {
      "path": "/Users/jon/projects/vtex/ethel"
    }
  },
  "agent": {
    "plan": {
      "permission": {
        "bash": {
          "*": "ask",
          "git diff *": "allow",
          "git status *": "allow",
          "git status": "allow",
          "ls": "allow",
          "npm run *": "allow",
          "pwd": "allow"
        }
      }
    },
    "explore": {
      "model": "opencode-go/deepseek-v4-flash",
      "variant": "low"
    }
  },
  "plugin": [
    [
      "file:///Users/jon/up-to-no-good/superpowers",
      {
        "directoryPrefix": "~/projects"
      }
    ],
    "@mohak34/opencode-notifier@latest",
    "@cortexkit/aft-opencode@latest",
    "@cortexkit/opencode-magic-context@latest",
    "@cortexkit/opencode-anthropic-auth@1.13.0",
    [
      "file:///Users/jon/up-to-no-good/replicants",
      {
        "preset": "standard",
        "presets": {
          "standard": {
            "light": {
              "model": "opencode-go/deepseek-v4-flash"
            },
            "standard": {
              "model": "opencode-go/deepseek-v4-flash",
              "variant": "high"
            },
            "heavy": {
              // "model": "anthropic/claude-fable-5"
              "model": "anthropic/claude-opus-4-8"
              // "model": "opencode-go/glm-5.2"
            }
          }
        }
      }
    ]
  ],
  "instructions": [
    "/Users/jon/.config/opencode/rules/*.md"
  ],
  "lsp": false,
  "snapshot": false,
  "compaction": {
    "auto": false,
    "prune": false
  },
  "provider": {
    "homelab": {
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "http://llm.homelab.jonmast.com/v1"
      },
      "models": {
        "qwen3.6": {
          "name": "Qwen 3.6"
        }
      }
    },
  }
}
